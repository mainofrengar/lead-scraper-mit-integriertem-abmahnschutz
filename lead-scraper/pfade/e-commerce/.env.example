# Schlüssel selbst hier eintragen (Texteditor), nie in einen Chat kopieren.
# ---- Pflicht ---------------------------------------------------------
SKAEL_API_KEY=eak_dein_key_hier
OPENAI_API_KEY=sk-dein_key_hier

# ---- Optional --------------------------------------------------------
# Findymail: zweiter Mailfinder für Geschäftsführer, nur wenn Skael nichts findet.
# Eigenes Abo (app.findymail.com → API). Restguthaben zeigt der Befehl `doctor`.
FINDYMAIL_API_KEY=

# ---- Modelle (Clay-Defaults aus „Vorlage | ECOM 2.0“) ----------------
OPENAI_MODEL_DEFAULT=gpt-4o-mini
# Domain-Suche: Clay nutzt einen Claygent mit gemini-2.5-flash-lite,
# hier der Skael-Rechercheagent mit demselben Modell
DOMAIN_AGENT_MODEL=google/gemini-2.5-flash-lite
DOMAIN_AGENT_MAX_STEPS=5

# ---- Traffic-Filter (Clay Import: MIN AVR TRAFFIC / MIN AVR H T 3 MO / MODE AND/OR) ----
# Standard = Clay: ein Shop wird angereichert, sobald SimilarWeb überhaupt Besuche misst.
MIN_AVR_TRAFFIC=1
MIN_MAX_TRAFFIC_3MO=1
TRAFFIC_MODE=OR

# ---- Durchsatz -------------------------------------------------------
SKAEL_RATE_LIMIT_PER_SEC=5
OPENAI_RATE_LIMIT_PER_SEC=2
MAX_CONCURRENCY=5
HTTP_TIMEOUT=180
# Höchstwartezeit je asynchronem Skael-Auftrag (Sekunden); danach wird die Zeile beim nächsten Lauf erneut versucht
SKAEL_MAX_WARTEZEIT=600
# Versuche je API-Aufruf bei vorübergehenden Fehlern (Netzwerk, 429, 5xx); Pausen 2/4/8/16 s, bei 429 5/10/20/40 s
MAX_RETRIES=5
BODYTEXT_MAX_CHARS=8192
ICP_BODYTEXT_MAX_CHARS=200000

# ---- Feature-Schalter ------------------------------------------------
USE_FINDYMAIL=true
DO_PERSONALISIERUNG=true
DO_VIDEO_TITLE=true

# ---- Sperrliste (Abo) ----------------------------------------------
# Es gibt keine öffentliche Liste. Mit Abo prüft der Export jede E-Mail-Adresse und Website einzeln
# gegen die Sperrliste auf dem Server (Stufen 1–6). Im Free-Plan gibt es keinen Abgleich, nur einen Hinweis.
# Abo abschließen bzw. verwalten: python3 -m ecom abo
# Lizenzschlüssel: wird beim ersten Aufruf kostenlos angelegt und im Benutzerordner gespeichert.
# Nur für einen Partner-Schlüssel hier eintragen:
# LIZENZ_SCHLUESSEL=
# Ab dieser Stufe kommt ein Lead in Liste 4 (gesperrt, nie anschreiben):
# SPERREN_AB=3
# Ab dieser Stufe bleibt ein Lead in Liste 1/2, bekommt aber die Spalte „Sperrliste Hinweis“:
# WARNEN_AB=1
# true = mit Abo und nicht erreichbarem Server kein Export
SPERRLISTE_PFLICHT=true

# ---- Ablage ----------------------------------------------------------
DB_PATH=data/shops.db
